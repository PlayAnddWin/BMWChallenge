# Copy to .env. Leave unused provider keys empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Optional explicit selection; otherwise OpenAI takes priority when configured.
LLM_PROVIDER=
BMW_DATA_DIR=./var/processed
BMW_RAW_DATA_DIR=./BMW-Data
BMW_OUTPUT_DIR=./var/exports
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bmwpassword
NEO4J_DATABASE=neo4j
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
API_PREFIX=/api
# Trusted factory(driver=..., repository=...) returning configured role adapters.
BACKEND_ADAPTER_FACTORY=
