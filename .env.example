# BMW ConceptCraft — canonical root configuration. Copy to a private .env.
# Process environment wins. Relative paths resolve against the repository root.
# OpenAI is the only live model provider; data/backend operations need no model key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

BMW_RAW_DATA_DIR=./BMW-Data
BMW_DATA_DIR=./var/processed
BMW_OUTPUT_DIR=./var/exports
BMW_CACHE_DIR=./var/cache

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bmwpassword
NEO4J_DATABASE=neo4j

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:${API_PORT}
API_PREFIX=/api
# Optional trusted factory(driver=..., repository=...) for Role 2/custom adapters.
# Real Role 1 evidence/import providers are wired by default.
BACKEND_ADAPTER_FACTORY=

STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
